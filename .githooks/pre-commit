#!/bin/sh
set -eu
if git diff --cached --name-only -- cv scripts/build_cv.py | grep -q .; then
    if ! git diff --quiet -- cv scripts/build_cv.py; then
        echo 'Stage all CV source changes before committing so source and PDF stay aligned.' >&2
        exit 1
    fi
    python3 scripts/build_cv.py
    git add cv.pdf cv_cn.pdf
fi
python3 scripts/update_date.py
git add index.html
